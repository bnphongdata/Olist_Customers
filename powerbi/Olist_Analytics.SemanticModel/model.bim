          },
          {
            "name": "Đơn hàng Vùng Đông Nam",
            "description": "Số đơn hàng phát sinh tại vùng kinh tế trọng điểm Đông Nam (Sudeste)",
            "expression": "CALCULATE([Tổng đơn hàng], Dim_Geography[region_code] = \"Sudeste\")",
            "formatString": "#,##0",
            "displayFolder": "03. Phân Tích Địa Lý & Vùng Miền",
            "lineageTag": "21ec2e52-ef12-44fc-a477-bf124df035ee",
            "dataType": "int64",
            "modifiedTime": "2026-10-16T08:55:27.153333",
            "structureModifiedTime": "2026-10-16T08:55:27.136667"
          },
          {
            "name": "% Tỷ trọng Đơn hàng Vùng",
            "description": "Tỷ trọng đơn hàng theo vùng so với tổng số đơn được lọc",
            "expression": "DIVIDE([Tổng đơn hàng], CALCULATE([Tổng đơn hàng], ALLSELECTED(Fact_Customer_Orders)), 0)",
            "formatString": "0.00%",
            "displayFolder": "03. Phân Tích Địa Lý & Vùng Miền",
