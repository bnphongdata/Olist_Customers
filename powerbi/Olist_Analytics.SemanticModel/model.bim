          },
          {
            "name": "Tổng khách hàng Unique",
            "description": "Tổng số lượng khách hàng định danh duy nhất (Unique Human Customers)",
            "expression": "DISTINCTCOUNT(Dim_Customers[customer_unique_id])",
            "formatString": "#,##0",
            "displayFolder": "01. Quy Mô & Sản Lượng",
            "lineageTag": "d696a841-e16c-421c-9934-fa9280458340",
            "dataType": "int64",
            "modifiedTime": "2026-10-16T08:55:27.153333",
            "structureModifiedTime": "2026-10-16T08:55:27.136667"
          },
          {
            "name": "Tần suất mua TB (Đơn/Khách)",
            "description": "Tần suất đặt hàng trung bình trên mỗi khách hàng (Đơn/Khách)",
            "expression": "DIVIDE([Tổng đơn hàng], [Tổng khách hàng Unique], 0)",
            "formatString": "0.000",
            "displayFolder": "01. Quy Mô & Sản Lượng",
            "lineageTag": "03d47d7e-d7c2-40ba-bbe0-c7f4bf09165f",
            "dataType": "double",
            "modifiedTime": "2026-10-16T08:55:27.153333",
            "structureModifiedTime": "2026-10-16T08:55:27.136667"
          },
          {
            "name": "Khách hàng mua 1 lần",
            "description": "Số lượng khách hàng chỉ mua duy nhất 1 lần rồi rời bỏ",
            "expression": "CALCULATE(DISTINCTCOUNT(Fact_Customer_Orders[customer_unique_id]), Dim_Customers[order_count] = 1)",
            "formatString": "#,##0",
            "displayFolder": "02. Giữ Chân & Khách Hàng Thân Thiết",
            "lineageTag": "1f623061-0711-49e8-931f-e8f7db31360b",
            "dataType": "int64",
            "modifiedTime": "2026-10-16T08:55:27.153333",
            "structureModifiedTime": "2026-10-16T08:55:27.136667"
          },
          {
            "name": "Khách hàng quay lại (>=2 đơn)",
            "description": "Số lượng khách hàng đã mua từ 2 đơn hàng trở lên",
            "expression": "CALCULATE(DISTINCTCOUNT(Fact_Customer_Orders[customer_unique_id]), Dim_Customers[order_count] > 1)",
            "formatString": "#,##0",
            "displayFolder": "02. Giữ Chân & Khách Hàng Thân Thiết",
            "lineageTag": "7e795004-334b-44c3-a482-b201b0bc0545",
            "dataType": "int64",
            "modifiedTime": "2026-10-16T08:55:27.153333",
            "structureModifiedTime": "2026-10-16T08:55:27.136667"
          },
          {
            "name": "Tỷ lệ mua lại (%)",
            "description": "Tỷ lệ khách hàng mua lại trên tổng số khách hàng định danh (%)",
            "expression": "DIVIDE([Khách hàng quay lại (>=2 đơn)], [Tổng khách hàng Unique], 0)",
            "formatString": "0.00%",
            "displayFolder": "02. Giữ Chân & Khách Hàng Thân Thiết",
            "lineageTag": "febe5978-6af4-4147-8853-a52b5f415819",
            "dataType": "double",
            "modifiedTime": "2026-10-16T08:55:27.153333",
            "structureModifiedTime": "2026-10-16T08:55:27.136667"
          },
          {
            "name": "Khách hàng VIP (>=5 đơn)",
            "description": "Số lượng khách hàng siêu trung thành có từ 5 đơn hàng trở lên",
            "expression": "CALCULATE(DISTINCTCOUNT(Fact_Customer_Orders[customer_unique_id]), Dim_Customers[order_count] >= 5)",
            "formatString": "#,##0",
            "displayFolder": "02. Giữ Chân & Khách Hàng Thân Thiết",
            "lineageTag": "790c9a00-0807-4400-a0cf-bfce3c518037",
