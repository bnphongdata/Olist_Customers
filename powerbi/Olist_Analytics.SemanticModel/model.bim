          },
          {
            "name": "Số đô thị có đơn hàng",
            "description": "Tổng số thành phố/đô thị có khách hàng đặt hàng trên toàn quốc",
            "expression": "DISTINCTCOUNT(Dim_Geography[customer_city])",
            "formatString": "#,##0",
            "displayFolder": "03. Phân Tích Địa Lý & Vùng Miền",
            "lineageTag": "00af69f4-f282-41c8-ba0d-c5cd69c7aa91",
