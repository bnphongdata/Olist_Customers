          },
          {
            "name": "Số bang phủ sóng",
            "description": "Tổng số bang của Brazil mà Olist đã tiếp cận khách hàng",
            "expression": "DISTINCTCOUNT(Dim_Geography[customer_state])",
            "formatString": "#,##0",
            "displayFolder": "03. Phân Tích Địa Lý & Vùng Miền",
            "lineageTag": "8bbc3840-ee4e-48eb-ab28-ae40882f08b2",
